<style>
/* ── Reviews Section ── */
#section-{{ section.id }} {
  position: relative;
  z-index: 2;
  padding-block: var(--sec-y);
  overflow: hidden;
}

/* ── Section header ── */
.rev-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  text-align: center;
  margin-bottom: 52px;
}

.rev-stat-row {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
  justify-content: center;
}

.rev-agg {
  display: flex;
  align-items: center;
  gap: 8px;
}

.rev-agg-num {
  font-family: var(--font-head);
  font-size: 2.2rem;
  font-weight: 800;
  color: var(--paper);
  line-height: 1;
}

.rev-agg-stars {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.rev-agg-stars .stars { font-size: .85rem; }

.rev-count {
  font-size: 11px;
  color: var(--paper-3);
  letter-spacing: .05em;
}

.rev-stat-sep {
  width: 1px;
  height: 36px;
  background: var(--g-line);
  flex-shrink: 0;
}

.rev-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.rev-stat-val {
  font-family: var(--font-head);
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--paper);
}

.rev-stat-label {
  font-size: 11px;
  color: var(--paper-3);
  letter-spacing: .05em;
}

/* ── Marquee rail ── */
.revwrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 8%,
    black 92%,
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 8%,
    black 92%,
    transparent 100%
  );
}

.revtrack {
  display: flex;
  gap: 20px;
  width: max-content;
  animation: marq 52s linear infinite;
}

.revtrack:nth-child(2) {
  animation-delay: -26s;
}

@keyframes marq {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ── Review card ── */
.revcard {
  flex-shrink: 0;
  width: 320px;
  padding: 24px 26px 22px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: var(--g-bg);
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  border: 1px solid var(--g-line);
  border-radius: var(--r);
  box-shadow: 0 18px 55px rgba(18,12,34,.38), var(--g-inset);
  transition: transform .3s var(--ease);
}

.revcard:hover {
  transform: translateY(-4px);
}

.revcard-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.revcard-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-lt), var(--brand));
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: .95rem;
  color: var(--paper);
  flex-shrink: 0;
}

.revcard-meta {
  flex: 1;
}

.revcard-author {
  font-family: var(--font-head);
  font-size: .88rem;
  font-weight: 600;
  color: var(--paper);
  line-height: 1.3;
}

.revcard-product {
  font-size: .75rem;
  color: var(--paper-3);
  margin-top: 2px;
}

.revcard-stars .stars { font-size: .8rem; }

.revcard-heading {
  font-family: var(--font-head);
  font-size: .95rem;
  font-weight: 700;
  color: var(--paper);
  line-height: 1.35;
}

.revcard-body {
  font-size: .82rem;
  color: var(--paper-3);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.revcard-verified {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: .72rem;
  color: var(--lime, #8ac926);
  font-weight: 600;
  letter-spacing: .04em;
  margin-top: auto;
}

.revcard-verified svg {
  width: 13px;
  height: 13px;
  stroke: var(--lime, #8ac926);
  fill: none;
  flex-shrink: 0;
}

/* ── Duplicate track rail (CSS-only seamless loop) ── */
.revwrap-inner {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Second rail scrolls opposite direction for visual depth */
.revtrack.reverse {
  animation-direction: reverse;
  animation-duration: 62s;
}
</style>

<section
  id="section-{{ section.id }}"
  class="sec"
  data-scene="2"
  aria-labelledby="rev-heading-{{ section.id }}"
>
  <div class="wrap">

    <!-- Header -->
    <div class="rev-header rv">
      <p class="kicker">{{ section.settings.kicker | default: 'Customer Reviews' }}</p>

      <div class="rev-stat-row">
        <div class="rev-agg">
          <span class="rev-agg-num">{{ section.settings.aggregate_rating | default: '4.8' }}</span>
          <div class="rev-agg-stars">
            <span class="stars" role="img" aria-label="4.8 out of 5 stars">★★★★★</span>
            <span class="rev-count">{{ section.settings.review_count | default: '8,000+' }} reviews</span>
          </div>
        </div>

        <div class="rev-stat-sep" aria-hidden="true"></div>

        <div class="rev-stat">
          <span class="rev-stat-val">{{ section.settings.homes_count | default: '12 lakh+' }}</span>
          <span class="rev-stat-label">Happy homes</span>
        </div>
      </div>

      <h2 class="d2" id="rev-heading-{{ section.id }}" style="margin-top:4px;">
        What Our Customers Say
      </h2>
    </div>

  </div><!-- /wrap -->

  <!-- Marquee — full bleed -->
  <div class="revwrap" role="list" aria-label="Customer reviews">

    {%- comment -%} First track {%- endcomment -%}
    <div class="revtrack" aria-hidden="false">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          {%- assign initial = block.settings.author | slice: 0 | upcase -%}
          <article class="revcard" {{ block.shopify_attributes }}>
            <div class="revcard-top">
              <div class="revcard-avatar" aria-hidden="true">{{ initial }}</div>
              <div class="revcard-meta">
                <div class="revcard-author">{{ block.settings.author | default: 'Happy Customer' }}</div>
                {%- if block.settings.product != blank -%}
                  <div class="revcard-product">{{ block.settings.product }}</div>
                {%- endif -%}
              </div>
              <div class="revcard-stars">
                {%- assign rating = block.settings.rating | default: 5 -%}
                <span class="stars" role="img" aria-label="{{ rating }} out of 5 stars">
                  {%- for i in (1..rating) -%}★{%- endfor -%}
                  {%- assign empty_stars = 5 | minus: rating -%}
                  {%- for i in (1..empty_stars) -%}<span style="opacity:.3">★</span>{%- endfor -%}
                </span>
              </div>
            </div>

            {%- if block.settings.heading != blank -%}
              <p class="revcard-heading">{{ block.settings.heading }}</p>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <p class="revcard-body">{{ block.settings.body }}</p>
            {%- endif -%}

            <div class="revcard-verified">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12l2 2 4-4"/>
                <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
              </svg>
              Verified Purchase
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          {%- assign initial = block.settings.author | slice: 0 | upcase -%}
          <article class="revcard" aria-hidden="true">
            <div class="revcard-top">
              <div class="revcard-avatar" aria-hidden="true">{{ initial }}</div>
              <div class="revcard-meta">
                <div class="revcard-author">{{ block.settings.author | default: 'Happy Customer' }}</div>
                {%- if block.settings.product != blank -%}
                  <div class="revcard-product">{{ block.settings.product }}</div>
                {%- endif -%}
              </div>
              <div class="revcard-stars">
                {%- assign rating = block.settings.rating | default: 5 -%}
                <span class="stars" role="img" aria-label="{{ rating }} out of 5 stars">
                  {%- for i in (1..rating) -%}★{%- endfor -%}
                  {%- assign empty_stars = 5 | minus: rating -%}
                  {%- for i in (1..empty_stars) -%}<span style="opacity:.3">★</span>{%- endfor -%}
                </span>
              </div>
            </div>
            {%- if block.settings.heading != blank -%}
              <p class="revcard-heading">{{ block.settings.heading }}</p>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="revcard-body">{{ block.settings.body }}</p>
            {%- endif -%}
            <div class="revcard-verified">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12l2 2 4-4"/>
                <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
              </svg>
              Verified Purchase
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div><!-- /revtrack -->

  </div><!-- /revwrap -->

</section>

