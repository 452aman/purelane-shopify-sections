{{ 'purelane-base.css' | asset_url | stylesheet_tag }}

<style>
/* ── Scenes (fixed full-screen background) ── */
.scenes {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.scene {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 1.1s cubic-bezier(.2,.7,.2,1);
  will-change: opacity;
}

.scene.on { opacity: 1; }

/* Scene 1 – hero: deep purple */
.scene-1 {
  background: radial-gradient(ellipse 80% 60% at 60% 30%,
    rgba(107,85,184,.38) 0%,
    rgba(36,26,61,.0) 70%),
    linear-gradient(180deg, #17102b 0%, #1e1535 100%);
}

/* Scene 2 – shop: teal wash */
.scene-2 {
  background: radial-gradient(ellipse 90% 70% at 30% 50%,
    rgba(30,120,100,.38) 0%,
    rgba(23,16,43,.0) 65%),
    linear-gradient(180deg, #14202b 0%, #17102b 100%);
}

/* Scene 3 – combos: warm amber */
.scene-3 {
  background: radial-gradient(ellipse 80% 65% at 70% 40%,
    rgba(201,118,29,.24) 0%,
    rgba(23,16,43,.0) 65%),
    linear-gradient(180deg, #1c1628 0%, #17102b 100%);
}

/* Scene 4 – bundles: brand purple */
.scene-4 {
  background: radial-gradient(ellipse 90% 80% at 40% 60%,
    rgba(75,58,143,.36) 0%,
    rgba(23,16,43,.0) 70%),
    linear-gradient(180deg, #17102b 0%, #241a3d 100%);
}

/* Animated water layer on scene-1 */
.scene-1 .water {
  position: absolute;
  bottom: -20%;
  left: -10%;
  width: 120%;
  height: 60%;
  border-radius: 50% 55% 48% 52% / 50% 50% 50% 50%;
  background: rgba(75,58,143,.12);
  animation: waterFloat 14s ease-in-out infinite;
  filter: blur(2px);
}

.scene-1 .water:nth-child(2) {
  bottom: -30%;
  left: 5%;
  width: 110%;
  background: rgba(107,85,184,.09);
  animation-duration: 19s;
  animation-direction: reverse;
}

.scene-1 .water:nth-child(3) {
  bottom: -25%;
  left: -5%;
  background: rgba(138,201,38,.06);
  animation-duration: 24s;
  animation-delay: -7s;
}

@keyframes waterFloat {
  0%, 100% { transform: translateY(0) rotate(0deg) scaleX(1); }
  33%       { transform: translateY(-18px) rotate(2deg) scaleX(1.03); }
  66%       { transform: translateY(10px) rotate(-2deg) scaleX(.97); }
}

/* ── Ticker bar ── */
.ticker {
  position: relative;
  z-index: 10;
  background: linear-gradient(90deg, var(--brand) 0%, var(--brand-lt) 100%);
  height: 38px;
  display: flex;
  align-items: center;
  overflow: hidden;
  border-bottom: 1px solid rgba(236,230,247,.18);
}

.ticker-track {
  display: flex;
  width: max-content;
  animation: tickerScroll 28s linear infinite;
  white-space: nowrap;
}

.ticker-inner {
  display: flex;
  align-items: center;
  gap: 0;
}

.ticker-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 28px;
  font-family: var(--font-head);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: rgba(236,230,247,.9);
  flex-shrink: 0;
}

.ticker-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}

@keyframes tickerScroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ── Nav pill ── */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 14px 0;
  transition: padding .35s var(--ease), background .35s var(--ease);
}

.header.up {
  padding: 8px 0;
}

.header.hidden {
  transform: translateY(-100%);
  transition: transform .35s var(--ease), padding .35s var(--ease);
}

.navpill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 10px 20px 10px 16px;
  border-radius: 999px;
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-head);
  font-weight: 800;
  font-size: 1.15rem;
  letter-spacing: -.01em;
  color: var(--paper);
  flex-shrink: 0;
}

.nav-logo-mark {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-lt), var(--lime, #8ac926));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
  flex: 1;
  justify-content: center;
}

.nav-links a {
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 500;
  color: var(--paper-3);
  transition: color .2s, background .2s;
}

.nav-links a:hover {
  color: var(--paper);
  background: rgba(236,230,247,.10);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.nav-cart {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(236,230,247,.10);
  border: 1px solid var(--g-line);
  transition: background .2s;
}

.nav-cart:hover { background: rgba(236,230,247,.20); }

.nav-cart svg { width: 18px; height: 18px; stroke: var(--paper); fill: none; }

.cart-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  border-radius: 999px;
  background: var(--accent);
  color: var(--ink);
  font-size: 10px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-head);
}

@media (max-width: 768px) {
  .nav-links { display: none; }
  .navpill { padding: 8px 14px 8px 12px; }
}

/* ── Hero section ── */
.hero-sec {
  position: relative;
  z-index: 2;
  min-height: calc(100svh - 38px - 66px);
  display: flex;
  align-items: center;
  padding: 60px 0 80px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 40px;
  align-items: center;
}

.hero-copy {
  max-width: 620px;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 5px 14px;
  border-radius: 999px;
  background: rgba(138,201,38,.15);
  border: 1px solid rgba(138,201,38,.28);
  font-family: var(--font-head);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--lime, #8ac926);
  margin-bottom: 24px;
}

.hero-eyebrow-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--lime, #8ac926);
  animation: pulse 2.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: .5; transform: scale(.7); }
}

.hero-h1 {
  font-family: var(--font-head);
  font-size: clamp(2.8rem, 6.5vw, 5.2rem);
  font-weight: 800;
  line-height: 1.02;
  letter-spacing: -.025em;
  color: var(--paper);
  margin-bottom: 20px;
}

.hero-sub {
  font-family: var(--font-body);
  font-size: clamp(1rem, 1.6vw, 1.15rem);
  color: var(--paper-3);
  line-height: 1.65;
  max-width: 480px;
  margin-bottom: 36px;
}

.hero-sub p { margin: 0; }

.hero-ctas {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

/* ── Badge rail ── */
.badge-rail {
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-self: center;
}

.badge-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  border-radius: var(--r-sm);
  min-width: 220px;
  background: var(--g-bg);
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  border: 1px solid var(--g-line);
  box-shadow: 0 12px 40px rgba(18,12,34,.3), var(--g-inset);
}

.badge-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(138,201,38,.15);
  border: 1px solid rgba(138,201,38,.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

.badge-text {
  font-family: var(--font-head);
  font-size: 13px;
  font-weight: 600;
  color: var(--paper);
  line-height: 1.35;
}

@media (max-width: 840px) {
  .hero-grid {
    grid-template-columns: 1fr;
  }

  .badge-rail {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
  }

  .badge-card {
    min-width: 0;
    flex: 1 1 160px;
  }
}

@media (max-width: 480px) {
  .hero-sec {
    padding: 40px 0 60px;
  }

  .hero-ctas {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-ctas .btn { width: 100%; justify-content: center; }
}
</style>

