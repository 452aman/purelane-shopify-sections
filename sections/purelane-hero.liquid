<header class="header" role="banner">
  <div class="wrap">
    <nav class="navpill glass" aria-label="Main navigation">

      <a href="/" class="nav-logo" aria-label="{{ shop.name }} home">
        <span class="nav-logo-mark" aria-hidden="true">🌿</span>
        <span>Purelane</span>
      </a>

      <ul class="nav-links" role="list">
        <li><a href="/collections/all">Shop</a></li>
        <li><a href="/pages/ingredients">Ingredients</a></li>
        <li><a href="/pages/bundles">Bundles</a></li>
        <li><a href="/pages/about">Our Story</a></li>
      </ul>

      <div class="nav-actions">
        <a href="{{ routes.cart_url }}" class="nav-cart" aria-label="Cart">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span class="cart-badge" data-cart-count hidden>0</span>
        </a>

        <a href="{{ section.settings.cta_primary_url | default: '/collections/all' }}" class="btn btn-primary">
          {{ section.settings.cta_primary_label | default: 'Shop Now' }}
        </a>
      </div>

    </nav>
  </div>
</header>

<!-- ══════════════════════════════════════════
     HERO SECTION
══════════════════════════════════════════ -->
<section
  id="section-{{ section.id }}"
  class="sec hero-sec"
  data-scene="1"
  aria-label="Hero"
>
  <div class="wrap">
    <div class="hero-grid">

      <!-- Left: copy -->
      <div class="hero-copy">
        <div class="hero-eyebrow rv">
          <span class="hero-eyebrow-dot"></span>
          Plant-Based Homecare
        </div>

        <h1 class="hero-h1 rv" data-delay="1">
          {%- assign full_heading = section.settings.heading | default: 'Clean That Lasts' -%}
          {%- assign highlight = section.settings.heading_highlight | default: 'Lasts' -%}
          {%- if highlight != blank and full_heading contains highlight -%}
            {{ full_heading | replace: highlight, '<span class="lime">' | append: highlight | append: '</span>' }}
          {%- else -%}
            {{ full_heading }}
          {%- endif -%}
        </h1>

        <div class="hero-sub rv" data-delay="2">
          {{ section.settings.subheading | default: '<p>Powerful home cleaning powered entirely by plants. No toxins, no compromise — just a home that smells like nature and stays spotless longer.</p>' }}
        </div>

        <div class="hero-ctas rv" data-delay="3">
          <a
            href="{{ section.settings.cta_primary_url | default: '/collections/all' }}"
            class="btn btn-primary btn-lg"
          >
            {{ section.settings.cta_primary_label | default: 'Shop All Products' }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>

          {%- if section.settings.cta_secondary_label != blank -%}
            <a
              href="{{ section.settings.cta_secondary_url | default: '/pages/our-story' }}"
              class="btn btn-ghost btn-lg"
            >
              {{ section.settings.cta_secondary_label }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Right: badge rail -->
      <div class="badge-rail" role="list">
        {%- assign badges = '' | split: '' -%}

        {%- if section.settings.badge_1_text != blank -%}
          <div class="badge-card rv" data-delay="2" role="listitem">
            <div class="badge-icon" aria-hidden="true">🌿</div>
            <div class="badge-text">{{ section.settings.badge_1_text }}</div>
          </div>
        {%- else -%}
          <div class="badge-card rv" data-delay="2" role="listitem">
            <div class="badge-icon" aria-hidden="true">🌿</div>
            <div class="badge-text">Plant Powered</div>
          </div>
        {%- endif -%}

        {%- if section.settings.badge_2_text != blank -%}
          <div class="badge-card rv" data-delay="3" role="listitem">
            <div class="badge-icon" aria-hidden="true">🐾</div>
            <div class="badge-text">{{ section.settings.badge_2_text }}</div>
          </div>
        {%- else -%}
          <div class="badge-card rv" data-delay="3" role="listitem">
            <div class="badge-icon" aria-hidden="true">🐾</div>
            <div class="badge-text">Safe for Kids &amp; Pets</div>
          </div>
        {%- endif -%}

        {%- if section.settings.badge_3_text != blank -%}
          <div class="badge-card rv" data-delay="4" role="listitem">
            <div class="badge-icon" aria-hidden="true">✨</div>
            <div class="badge-text">{{ section.settings.badge_3_text }}</div>
          </div>
        {%- else -%}
          <div class="badge-card rv" data-delay="4" role="listitem">
            <div class="badge-icon" aria-hidden="true">✨</div>
            <div class="badge-text">Zero Harsh Chemicals</div>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{{ 'purelane-scenes.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "div",
  "class": "purelane-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean That Lasts"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Word(s) to highlight in lime",
      "default": "Lasts",
      "info": "Must match exactly a word in the heading above."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Powerful home cleaning powered entirely by plants. No toxins, no compromise — just a home that smells like nature and stays spotless longer.</p>"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "header",
      "content": "Trust Badges"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 text",
      "default": "Plant Powered"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 text",
      "default": "Safe for Kids & Pets"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 text",
      "default": "Zero Harsh Chemicals"
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}
